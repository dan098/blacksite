# Optional local service environment: data/integrations.env (chmod 600).
# The application does not automatically load .env files.
# Internet-enabled analysis can disclose guest data; offline is the default.
BLACKSITE_NETWORK=offline

# Opt-in HASH-ONLY lookups. 0 = disabled; 1 = enabled with a configured key.
# No automatic sample upload. Hashes themselves can be sensitive.
SANDBOX_VT_HASH_LOOKUP=0
VT_API_KEY=
SANDBOX_HA_HASH_LOOKUP=0
HYBRID_ANALYSIS_API_KEY=

# Optional external EDR lookup; all values blank by default.
SANDBOX_ELASTIC_URL=
SANDBOX_ELASTIC_API_KEY=
SANDBOX_ELASTIC_HOST_ID=

# Optional redacted sharing: requires your own HTTPS origin/public gateway.
SANDBOX_PUBLIC_ORIGIN=
